{
  "appId": "org.resala.rtc.masar",
  "appName": "مسار RTC",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#f7f9fb",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#f7f9fb"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#00288e"
    }
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "appendUserAgent": "MasarRTC/1.0"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "jwhedqmszbdougsqqmhv.supabase.co",
      "*.supabase.co",
      "accounts.google.com",
      "*.google.com",
      "*.googleusercontent.com",
      "shaker15s.github.io",
      "*.github.io"
    ]
  }
}

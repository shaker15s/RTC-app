# ═══════════════════════════════════════════
#  RTC-app — Git Ignore
# ═══════════════════════════════════════════

# Node / npm
node_modules/

# Capacitor native projects are source and stay tracked; only generated builds are ignored.
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App/public/
ios/App/Podfile.lock

# Build output (generated from source)
dist/
build/
styles.css
*.min.js

# Store listing assets are tracked; regenerate icons with: npm run icons

# Native launcher icons are tracked because they are part of each store build.

# Internal design/review documents (keep local only, not published)
RTC-MASTER-REPORT.md
.claude/

# Playwright capture dumps (console/page artifacts)
.playwright-mcp/
RTC-PRD.pptx
RTC-Sitemap-UserFlows.md

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript build artifacts
*.tsbuildinfo

# Native credentials and signing material — never commit
android/app/google-services.json
android/*.jks
android/*.keystore
android/app/*.jks
android/app/*.keystore
ios/**/GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
*.cer

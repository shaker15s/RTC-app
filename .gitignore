# ═══════════════════════════════════════════
#  RTC-app — Git Ignore
# ═══════════════════════════════════════════

# Node / npm
node_modules/
package-lock.json

# Capacitor Native builds (regenerated by `npx cap sync`)
android/
ios/

# Build output (generated from source)
dist/
build/
styles.css
*.min.js

# PWA icons (generated by `npm run icons`)
icon-192.png
icon-512.png

# Internal design/review documents (keep local only, not published)
RTC-MASTER-REPORT.md
.claude/

# Playwright capture dumps (console/page artifacts)
.playwright-mcp/
RTC-PRD.pptx
RTC-Sitemap-UserFlows.md

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# TypeScript build artifacts
*.tsbuildinfo
